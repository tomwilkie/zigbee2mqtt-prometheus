{
  "name": "Zigbee2MQTT (Prometheus)",
  "version": "2.13.0-1e1df702",
  "slug": "zigbee2mqtt_prometheus",
  "description": "Zigbee2MQTT with the Prometheus exporter extension (unofficial fork build)",
  "uart": true,
  "udev": true,
  "url": "https://github.com/tomwilkie/zigbee2mqtt-prometheus",
  "startup": "application",
  "services": [
    "mqtt:need"
  ],
  "hassio_api": true,
  "arch": [
    "amd64"
  ],
  "boot": "manual",
  "init": false,
  "ingress": true,
  "timeout": 30,
  "panel_icon": "mdi:chart-line",
  "map": [
    {
      "type": "share",
      "read_only": false
    },
    {
      "type": "homeassistant_config",
      "read_only": false,
      "path": "/config"
    },
    {
      "type": "addon_config",
      "read_only": false,
      "path": "/addon_config"
    }
  ],
  "ports": {
    "8485/tcp": null,
    "8099/tcp": null,
    "9142/tcp": 9142
  },
  "ports_description": {
    "8485/tcp": "Socat tcp-listen port",
    "8099/tcp": "Frontend tcp-listen port",
    "9142/tcp": "Prometheus exporter metrics port"
  },
  "options": {
    "data_path": "/config/zigbee2mqtt-prometheus",
    "socat": {
      "enabled": false,
      "master": "pty,raw,echo=0,link=/tmp/ttyZ2M,mode=777",
      "slave": "tcp-listen:8485,keepalive,nodelay,reuseaddr,keepidle=1,keepintvl=1,keepcnt=5",
      "options": "-d -d",
      "log": false
    },
    "mqtt": {},
    "serial": {},
    "prometheus_exporter": {
      "enabled": true,
      "port": 9142
    }
  },
  "schema": {
    "data_path": "str",
    "socat": {
      "enabled": "bool?",
      "master": "str?",
      "slave": "str?",
      "options": "str?",
      "log": "bool?"
    },
    "mqtt": {
      "server": "str?",
      "ca": "str?",
      "key": "str?",
      "cert": "str?",
      "user": "str?",
      "password": "str?",
      "base_topic": "str?"
    },
    "serial": {
      "port": "str?",
      "adapter": "match(zstack|deconz|zigate|ezsp|ember|zboss)?",
      "baudrate": "int?",
      "rtscts": "bool?"
    },
    "prometheus_exporter": {
      "enabled": "bool?",
      "port": "int?",
      "host": "str?"
    },
    "watchdog": "str?",
    "force_onboarding": "bool?"
  },
  "image": "tomwilkie/zigbee2mqtt-prometheus-{arch}"
}
